# Copy to .env for local use; keep .env out of source control.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_PATH=backend/instance/library.sqlite3
COOKIE_SECURE=false
FLASK_DEBUG=false
PORT=5000
APP_ENV=development
# Supply only while running `flask create-demo-user`; never commit the value.
DEMO_PASSWORD=
# Production-only: Render prompts for this secret when creating the Blueprint.
# It is used once to hash the first account on a fresh production database.
INITIAL_USER_PASSWORD=
